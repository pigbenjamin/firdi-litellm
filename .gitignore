# 環境變數（含 API key、master key 等機敏資訊）
.env

# 使用記錄（保留目錄結構但不追蹤內容，包含 docker-compose/logs 等巢狀目錄）
**/logs/*
!**/logs/.gitkeep

# 使用者資料庫（SQLite，含真實使用者資料）
data/*
!data/.gitkeep

# HuggingFace 模型快取
.cache/

# Python
__pycache__/
*.pyc
*.pyo

# Java / Maven build 產物（keycloak plugin）
target/
# 例外：keycloak-user-sync-listener 編譯好的 jar 要進 git，方便部署到其他機器
!keycloak/plugins/keycloak-user-sync-listener/target/
keycloak/plugins/keycloak-user-sync-listener/target/*
!keycloak/plugins/keycloak-user-sync-listener/target/keycloak-user-sync-listener-1.0.0.jar

# macOS
.DS_Store
