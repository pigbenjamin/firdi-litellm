# ── LiteLLM ──────────────────────────────────────────────────────────────────
LITELLM_MASTER_KEY=sk-firdi-master-change-me
LOG_PATH=/app/logs/usage.jsonl
# Postgres 密碼（k8s/postgres/，供 LiteLLM store_model_in_db 用，見
# docs/external-models-ops.md「路線 C：自助上架」）。只在 PVC 內第一次 initdb 時
# 生效，事後改這個值不會自動輪替 Postgres 裡實際的密碼（見 scripts/deploy.sh
# deploy_secrets() 的說明）。
POSTGRES_PASSWORD=change-me-postgres-password

# ── Admin API ─────────────────────────────────────────────────────────────────
ADMIN_API_KEY=sk-admin-change-me

# ── Keycloak 使用者同步（admin-api sync endpoint 使用）────────────────────────
WEBHOOK_SECRET=change-me-webhook-secret
KEYCLOAK_URL=https://keycloak.example.com
KEYCLOAK_REALM=firdi
KEYCLOAK_CLIENT_ID=user-sync-service
KEYCLOAK_CLIENT_SECRET=change-me-client-secret
# self-signed cert: false 停用驗證，或填 CA 憑證路徑（如 /app/certs/keycloak-ca.crt）
KEYCLOAK_SSL_VERIFY=false

# ── 自助端點網頁登入（admin-api /api/v1/me/web/login，見 keycloak/SETUP.md）─────
# 獨立的 Keycloak client（Standard flow / Authorization Code），不要跟上面
# KEYCLOAK_CLIENT_ID 共用——那個是 webhook 專用的 service-account client。
KEYCLOAK_SELFSERVICE_CLIENT_ID=firdi-admin-api-selfservice
KEYCLOAK_SELFSERVICE_CLIENT_SECRET=change-me-selfservice-client-secret
# 使用者瀏覽器看得到的 admin-api 網址（反向代理位址，或單節點測試用
# http://<node-ip>:30408）。Keycloak 登入完會把瀏覽器導回這裡，跟叢集內部 DNS
# 是兩回事；這裡也要設定成 Keycloak client 的 Valid Redirect URI 允許的來源
ADMIN_API_PUBLIC_URL=http://10.90.20.55:30408
# 選填：只有當 Keycloak 自己認定的官方 hostname 跟上面 KEYCLOAK_URL 不同時才需要
# 設定（多數單一 hostname 的部署留空即可，會自動 fallback 用 KEYCLOAK_URL）。
# 判斷方式：瀏覽器登入後若卡在 Keycloak 的「Restart login cookie not found」
# 錯誤頁，代表 Keycloak 的登入表單被導向了另一個網域——查
# https://<KEYCLOAK_URL>/realms/<realm>/.well-known/openid-configuration 的
# "authorization_endpoint" 欄位，那個網域就是這裡要填的值
KEYCLOAK_BROWSER_URL=

# ── K8s 部署路徑 ──────────────────────────────────────────────────────────────
# users-db-pvc / litellm-logs-pvc 的 storageClassName（動態佈建，見
# k8s/shared-storage/pvc.yaml）。單節點 k3s 用內建的 local-path 即可；公司 Ceph
# 叢集請改成 rook-ceph-block（或該叢集實際的 storage class 名稱，跑
# `kubectl get storageclass` 確認）
K8S_PVC_STORAGE_CLASS=local-path
# 舊機器 hostPath 遺留的 users.db 路徑（僅供 deploy.sh users-db 首次搬遷資料用；
# users-db-pvc 本身已經是動態佈建，不再是這個目錄本身）。全新環境可留空
K8S_DATA_HOST_PATH=/opt/firdi/data
# Node 上 HuggingFace 模型快取目錄（hostPath，type: DirectoryOrCreate，會自動建立）
K8S_HF_CACHE_HOST_PATH=/opt/firdi/hf-cache
# marker-service 讀寫 PDF/md 的目錄（hostPath），須與 docblock-rag-platform 的
# docblock-ingest-pv 指向同一實體路徑，否則 marker-service 讀不到 ingest-worker 寫入的檔案。
# 多節點叢集必填：留空的話 deploy.sh 會直接報錯中止，因為 PV 的 hostPath type 是
# DirectoryOrCreate，路徑填錯不會有任何錯誤——kubelet 會靜默建一個空目錄，轉檔看起來
# 成功但檔案寫進沒有人讀的地方。單節點才允許留空（沿用下面這個預設值）。
K8S_MARKER_INGEST_HOST_PATH=/home/ai-x/data/docblock/ingest

# ── 多節點 K8s（單節點 k3s 可留空，deploy.sh 會自動帶入該節點名稱）──────────────
# 承載 marker-ingest hostPath（K8S_MARKER_INGEST_HOST_PATH）的節點名稱。
# **多節點叢集必填，留空 deploy.sh 會報錯中止**：以前留空是靜默 fallback 成本機
# hostname，而在多節點上「你剛好登入的那台」通常不是 GPU 節點——2026-08-19 就是這樣
# 讓正式叢集的 light-models 被釘在無 GPU 的入口節點、Pending 了 14 天沒人發現。
# 另外 deploy.sh 也會檢查這個節點是否真的存在、是否有 nvidia.com/gpu。
# 只有 light-models 的 nodeSelector 與 marker-ingest-pv 的 nodeAffinity 還吃這個變數
# （PV 用 hostPath，硬釘死一個節點）；gemma-4-31b / gemma-4-26b 已改走浮動 GPU 池
# （nodeSelector: gpu-pool=shared + PriorityClass 搶佔），部署前記得先跑
# ./scripts/label-nodes.sh 幫每個 GPU 節點貼上 gpu-pool=shared label
K8S_GPU_NODE_HOSTNAME=
# 叢集為多節點時，admin-api / light-models image 需推到所有節點都能存取的 registry
# （單節點 k3s 留空，沿用本地 build + k3s ctr import）
REGISTRY=
# REGISTRY 需要登入才能 push/pull 時填入帳密（例如 ghcr.io：GitHub 帳號 + PAT，
# PAT 需要 write:packages 權限來 push、read:packages 權限給叢集 pull）
# deploy.sh 會用這組帳密登入 push，並（連同 K8S_IMAGE_PULL_SECRET 一起設定時）
# 自動建立叢集端 pull 用的 docker-registry secret
REGISTRY_USERNAME=
REGISTRY_PASSWORD=
# 私有 registry 才需要：k8s secret 名稱，admin-api / light-models 的 Deployment
# 會自動掛上這個 imagePullSecrets（用 kubectl patch，留空則完全不影響 deployment.yaml）
K8S_IMAGE_PULL_SECRET=

# ── OpenWebUI 整合 ────────────────────────────────────────────────────────────
# OPENWEBUI_SERVICE_KEY：OpenWebUI 後端連線設定填入的 API key（自訂任意字串）
# OPENWEBUI_ADMIN_KEY：OpenWebUI 管理員帳號的 API key（用來查詢使用者身份）
OPENWEBUI_URL=http://10.90.20.55:5000
OPENWEBUI_ADMIN_KEY=change-me-openwebui-admin-key
OPENWEBUI_SERVICE_KEY=change-me-openwebui-service-key

# ── OpenWebUI 第二入口（入口 B，可選）───────────────────────────────────────────
# 部署第二個 OpenWebUI（例如另一台主機/叢集）、接同一個 Keycloak realm 時才需要。
# 三個值留空 = 停用，行為與單入口完全相同：custom_auth 不會把它納入
# OPENWEBUI_INSTANCES，admin-api pull 只讀入口 A，push target=b 回 status=skipped
# （HTTP 200，CronJob 安全 no-op）。詳見 docs/permission-sync.md「雙入口架構」。
#
# 啟用前提（沿用單入口的已知邊界，見 docs/permission-sync.md）：
#   - 入口 B 要接同一個 Keycloak realm（通常另開一個 OIDC client，Valid Redirect
#     URI 設成入口 B 自己的網址；不要跟入口 A 共用 client）
#   - 入口 B 開啟 ENABLE_OAUTH_GROUP_MANAGEMENT（group name = dept_id）與
#     ENABLE_FORWARD_USER_INFO_HEADERS
#   - 入口 B 的 LiteLLM connection（Workspace → Connections）API key 要填成跟
#     OPENWEBUI_SERVICE_KEY_B 一樣的值
#   - 入口 A 是唯一權限管理入口；在入口 B 改模型授權沒有意義，≤2 分鐘內會被
#     CronJob 從入口 A 的狀態還原
#
# 入口 B 的網址
OPENWEBUI_URL_B=
# 入口 B 管理員帳號的 API key（在該 OpenWebUI 的 Settings → Account 產生，
# 與入口 A 的 OPENWEBUI_ADMIN_KEY 不通用）
OPENWEBUI_ADMIN_KEY_B=
# 自訂任意字串，同時要填到入口 B 的 LiteLLM connection 設定裡（custom_auth 用它
# 分辨請求來自入口 A 還是入口 B，藉此決定去哪個實例把 UUID 解析成 Keycloak sub）
OPENWEBUI_SERVICE_KEY_B=

# ── 測試用（scripts/test_openwebui_auth.sh，dept A 測試使用者 key）──────────────
TEST_API_KEY=change-me-test-api-key

# ── External providers ────────────────────────────────────────────────────────
# 若只用地端 vLLM 可留空
OPENAI_API_KEY=
GEMINI_API_KEY=

# ── HuggingFace ───────────────────────────────────────────────────────────────
HF_TOKEN=
HF_HOME=./.cache/huggingface

# ── Langfuse（LLM 觀測/日誌）───────────────────────────────────────────────────
LANGFUSE_PUBLIC_KEY=change-me-langfuse-public-key
LANGFUSE_SECRET_KEY=change-me-langfuse-secret-key
LANGFUSE_HOST=http://10.90.20.55:3001

# ── Docker Compose：Host ports ────────────────────────────────────────────────
LITELLM_PORT=4000
QWEN_VLLM_PORT=9001
GPT_OSS_VLLM_PORT=9003

# ── Docker Compose：vLLM 參數 ─────────────────────────────────────────────────
QWEN_TENSOR_PARALLEL_SIZE=1
GPT_OSS_TENSOR_PARALLEL_SIZE=1

QWEN_GPU_MEMORY_UTILIZATION=0.80
GPT_OSS_GPU_MEMORY_UTILIZATION=0.65

QWEN_MAX_MODEL_LEN=32768
GPT_OSS_MAX_MODEL_LEN=32768
VLLM_SHM_SIZE=32gb
