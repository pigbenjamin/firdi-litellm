# ── LiteLLM ──────────────────────────────────────────────────────────────────
LITELLM_MASTER_KEY=sk-firdi-master-change-me
LOG_PATH=/app/logs/usage.jsonl

# ── Admin API ─────────────────────────────────────────────────────────────────
ADMIN_API_KEY=sk-admin-change-me

# ── Keycloak 使用者同步（admin-api sync endpoint 使用）────────────────────────
WEBHOOK_SECRET=change-me-webhook-secret
KEYCLOAK_URL=https://keycloak.example.com
KEYCLOAK_REALM=firdi
KEYCLOAK_CLIENT_ID=user-sync-service
KEYCLOAK_CLIENT_SECRET=change-me-client-secret
# self-signed cert: false 停用驗證，或填 CA 憑證路徑（如 /app/certs/keycloak-ca.crt）
KEYCLOAK_SSL_VERIFY=false

# ── K8s 部署路徑 ──────────────────────────────────────────────────────────────
# Node 上 SQLite 資料庫的實際目錄（PV hostPath）
# 部署前請先 mkdir -p 此目錄
K8S_DATA_HOST_PATH=/opt/firdi/data
# Node 上 LiteLLM 使用記錄目錄（hostPath，type: DirectoryOrCreate，會自動建立）
K8S_LOGS_HOST_PATH=/opt/firdi/logs
# Node 上 HuggingFace 模型快取目錄（hostPath，type: DirectoryOrCreate，會自動建立）
K8S_HF_CACHE_HOST_PATH=/opt/firdi/hf-cache
# marker-service 讀寫 PDF/md 的目錄（hostPath），須與 docblock-rag-platform 的
# docblock-ingest-pv 指向同一實體路徑，否則 marker-service 讀不到 ingest-worker 寫入的檔案
K8S_MARKER_INGEST_HOST_PATH=/home/ai-x/data/docblock/ingest

# ── 多節點 K8s（單節點 k3s 可留空，deploy.sh 會自動帶入本機 hostname）────────────
# 承載 K8S_DATA_HOST_PATH / K8S_LOGS_HOST_PATH 的節點名稱（須與 `kubectl get nodes` 的 NAME 一致）
# admin-api / litellm 會被釘選（nodeAffinity）到這個節點，兩個 hostPath 目錄都要建在它上面
K8S_STORAGE_NODE_HOSTNAME=
# 承載 GPU（K8S_HF_CACHE_HOST_PATH / K8S_MARKER_INGEST_HOST_PATH）的節點名稱
# 3 個 vLLM deployment 會被釘選（nodeSelector）到這個節點
K8S_GPU_NODE_HOSTNAME=
# 叢集為多節點時，admin-api / light-models image 需推到所有節點都能存取的 registry
# （單節點 k3s 留空，沿用本地 build + k3s ctr import）
REGISTRY=
# REGISTRY 需要登入才能 push/pull 時填入帳密（例如 ghcr.io：GitHub 帳號 + PAT，
# PAT 需要 write:packages 權限來 push、read:packages 權限給叢集 pull）
# deploy.sh 會用這組帳密登入 push，並（連同 K8S_IMAGE_PULL_SECRET 一起設定時）
# 自動建立叢集端 pull 用的 docker-registry secret
REGISTRY_USERNAME=
REGISTRY_PASSWORD=
# 私有 registry 才需要：k8s secret 名稱，admin-api / light-models 的 Deployment
# 會自動掛上這個 imagePullSecrets（用 kubectl patch，留空則完全不影響 deployment.yaml）
K8S_IMAGE_PULL_SECRET=

# ── OpenWebUI 整合 ────────────────────────────────────────────────────────────
# OPENWEBUI_SERVICE_KEY：OpenWebUI 後端連線設定填入的 API key（自訂任意字串）
# OPENWEBUI_ADMIN_KEY：OpenWebUI 管理員帳號的 API key（用來查詢使用者身份）
OPENWEBUI_URL=http://10.90.20.55:5000
OPENWEBUI_ADMIN_KEY=change-me-openwebui-admin-key
OPENWEBUI_SERVICE_KEY=change-me-openwebui-service-key

# ── 測試用（scripts/test_openwebui_auth.sh，dept A 測試使用者 key）──────────────
TEST_API_KEY=change-me-test-api-key

# ── External providers ────────────────────────────────────────────────────────
# 若只用地端 vLLM 可留空
OPENAI_API_KEY=
GEMINI_API_KEY=

# ── HuggingFace ───────────────────────────────────────────────────────────────
HF_TOKEN=
HF_HOME=./.cache/huggingface

# ── Langfuse（LLM 觀測/日誌）───────────────────────────────────────────────────
LANGFUSE_PUBLIC_KEY=change-me-langfuse-public-key
LANGFUSE_SECRET_KEY=change-me-langfuse-secret-key
LANGFUSE_HOST=http://10.90.20.55:3001

# ── Docker Compose：Host ports ────────────────────────────────────────────────
LITELLM_PORT=4000
QWEN_VLLM_PORT=9001
GPT_OSS_VLLM_PORT=9003

# ── Docker Compose：vLLM 參數 ─────────────────────────────────────────────────
QWEN_TENSOR_PARALLEL_SIZE=1
GPT_OSS_TENSOR_PARALLEL_SIZE=1

QWEN_GPU_MEMORY_UTILIZATION=0.80
GPT_OSS_GPU_MEMORY_UTILIZATION=0.65

QWEN_MAX_MODEL_LEN=32768
GPT_OSS_MAX_MODEL_LEN=32768
VLLM_SHM_SIZE=32gb
