LITELLM_MASTER_KEY=sk-firdi-master-change-me
USER_AUTH_CONFIG_PATH=/app/config/users.json
LOG_PATH=/app/logs/usage.jsonl

# External providers. Leave blank if you only want local vLLM models.
OPENAI_API_KEY=
GEMINI_API_KEY=

# Required for gated Hugging Face models or higher rate limits.
HF_TOKEN=
HF_HOME=./.cache/huggingface
GEMMA_VLLM_IMAGE=vllm/vllm-openai:gemma4-0505-cu130

# Host ports.
LITELLM_PORT=4000
QWEN_VLLM_PORT=8001
GEMMA_VLLM_PORT=8002
GPT_OSS_VLLM_PORT=8002

QWEN_TENSOR_PARALLEL_SIZE=1
GEMMA_TENSOR_PARALLEL_SIZE=1
GPT_OSS_TENSOR_PARALLEL_SIZE=1

# Tune these down if VRAM is tight.
QWEN_GPU_MEMORY_UTILIZATION=0.80
GEMMA_GPU_MEMORY_UTILIZATION=0.60
GPT_OSS_GPU_MEMORY_UTILIZATION=0.65
QWEN_MAX_MODEL_LEN=32768
GEMMA_MAX_MODEL_LEN=32768
GPT_OSS_MAX_MODEL_LEN=32768
VLLM_SHM_SIZE=32gb
